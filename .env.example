# Lokale Vorschau ohne Login (nicht für Produktion)
DEMO_MODE=false

# Keycloak (iam.csp-ag.ai)
# Issuer = https://iam.csp-ag.ai/realms/<REALM>
KEYCLOAK_CLIENT_ID=Pako_ko_strat
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=https://iam.csp-ag.ai/realms/master

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# AUTH_DEBUG=false

# Datenbank (Neon / Postgres; lokal und Vercel)
# Empfohlen: Neon pooled URL (?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# KI (OpenAI) — SWOT aus Dokument, Optimierung, Massnahmen-Vorschläge, qualitative Auswertung
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# E-Mail-Versand für Erinnerungen (optional; ohne Konfiguration erstellt der Admin-Bereich Mail-Entwürfe)
# Variante A — Microsoft 365 über Microsoft Graph (empfohlen, siehe README «E-Mail-Versand»):
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# Variante B — SMTP:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Absender (für beide Varianten; bei Graph muss das Postfach existieren):
# MAIL_FROM="CSP Strategie-Check <strategie-check@csp-ag.ch>"
