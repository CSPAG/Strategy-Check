# Lokale Vorschau ohne Login (nicht für Produktion)
DEMO_MODE=false

# Keycloak (iam.csp-ag.ai)
# Issuer = https://iam.csp-ag.ai/realms/<REALM>
KEYCLOAK_CLIENT_ID=strategy-check
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=https://iam.csp-ag.ai/realms/master

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# AUTH_DEBUG=false

# Datenbank (SQLite MVP; für SQL Server Connection String anpassen)
DATABASE_URL="file:./dev.db"
