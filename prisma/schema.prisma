generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  keycloakSub    String?   @unique
  keycloakIssuer String?
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           String    @default("TEAM_EDITOR")
  teamId         String?
  team           Team?     @relation(fields: [teamId], references: [id])
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Team {
  id          String       @id @default(cuid())
  name        String       @unique
  category    String
  teamType    String       @default("CIR")
  users       User[]
  assessments Assessment[]
  createdAt   DateTime     @default(now())
}

model Period {
  id          String       @id @default(cuid())
  name        String       @unique
  label       String
  isActive    Boolean      @default(true)
  assessments Assessment[]
  createdAt   DateTime     @default(now())
}

model Assessment {
  id       String @id @default(cuid())
  teamId   String
  periodId String
  status   String @default("DRAFT")
  teamType String @default("")

  summary               String @default("")
  strengths             String @default("")
  gaps                  String @default("")
  opportunities         String @default("")
  risks                 String @default("")
  measures              String @default("")
  strategicGoalMaturity String @default("{}")
  maturityNotes         String @default("")
  matrixNotes           String @default("")

  matrixXToday   Int @default(3)
  matrixYToday   Int @default(3)
  matrixXOutlook Int @default(3)
  matrixYOutlook Int @default(3)

  maturityToday   Int @default(2)
  maturityOutlook Int @default(2)

  radarMarketToday       Int @default(3)
  radarMarketOutlook     Int @default(3)
  radarPortfolioToday    Int @default(3)
  radarPortfolioOutlook  Int @default(3)
  radarInnovationToday   Int @default(3)
  radarInnovationOutlook Int @default(3)
  radarBusinessToday     Int @default(3)
  radarBusinessOutlook   Int @default(3)
  radarGrowthToday       Int @default(3)
  radarGrowthOutlook     Int @default(3)
  radarTalentToday       Int @default(3)
  radarTalentOutlook     Int @default(3)

  matMarketToday       Int @default(2)
  matMarketOutlook     Int @default(2)
  matPortfolioToday    Int @default(2)
  matPortfolioOutlook  Int @default(2)
  matInnovationToday   Int @default(2)
  matInnovationOutlook Int @default(2)
  matBusinessToday     Int @default(2)
  matBusinessOutlook   Int @default(2)
  matGrowthToday       Int @default(2)
  matGrowthOutlook     Int @default(2)
  matTalentToday       Int @default(2)
  matTalentOutlook     Int @default(2)

  strategicGoals String @default("[]")

  submittedAt DateTime?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  period Period @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([teamId, periodId])
}
